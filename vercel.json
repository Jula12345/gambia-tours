{
  "functions": {
    "api/submissions.js": {
      "maxDuration": 60
    },
    "api/admin/offers.js": {
      "maxDuration": 120,
      "includeFiles": "{lib/**,assets/offers/**,node_modules/pdfkit/js/data/**,tours.js,*-tour.html}"
    },
    "api/admin/offer-image.js": {
      "maxDuration": 60,
      "includeFiles": "assets/offers/*.jpg"
    },
    "api/admin/offer-pdf.js": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,assets/offers/**,node_modules/pdfkit/js/data/**,tours.js,*-tour.html}"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
